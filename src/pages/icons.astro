<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>图标投递 · Chaos 制作台</title>
<style is:global>
:root{color-scheme:dark;--bg:#101010;--panel:#1d1d1b;--line:#555550;--blue:#a8d7ff}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:#f2f1ed;font-family:system-ui,-apple-system,"PingFang SC",sans-serif}main{width:min(1080px,100%);margin:auto;padding:1.25rem clamp(1rem,4vw,3rem) 3rem}.top{display:flex;justify-content:space-between;align-items:center;color:#aaa;font-size:.8rem}.back-home{color:#a8d7ff;text-decoration:none;padding:.55rem .8rem;border:1px solid #3c3c39;border-radius:12px;transition:background .2s}.back-home:hover{background:#31594f;color:#fff}.device{background:var(--blue);color:#17242e;border-radius:18px;padding:.65rem 1rem;font-weight:600}h1{font-size:clamp(1.8rem,4vw,2.7rem);margin:3rem 0 .4rem}.muted{color:#aaa}.toolbar{display:flex;gap:.7rem;align-items:center;flex-wrap:wrap;margin:1.5rem 0}.count{font-size:1.3rem;font-weight:600}.button,input{border:1px solid var(--line);background:#171716;color:#eee;border-radius:14px;padding:.7rem 1rem}.button{cursor:pointer}.button.primary{background:var(--blue);color:#17242e;border:0}.tabs{display:flex;gap:.5rem;margin:1rem 0}.tab{border:1px solid #3c3c39;background:#191918;color:#bbb;border-radius:12px;padding:.55rem 1rem;cursor:pointer}.tab.active{background:#31594f;color:#fff;border-color:#31594f}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;margin:1rem 0 2rem}.slot{border:1px solid #292927;background:#1d1d1b;border-radius:18px;padding:.8rem;text-align:center}.slot.selected{outline:2px solid var(--blue);background:#26353a}.slot img{width:100%;aspect-ratio:1;border-radius:14px;object-fit:contain;background:#20201f;cursor:pointer}.slot-row{display:flex;flex-direction:column;align-items:stretch;gap:.45rem;margin-top:.65rem}.slot small{display:block;color:#e5e3de;font-size:.82rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.slot-actions{display:flex;flex-direction:column;gap:.5rem;width:100%}.slot-action{width:100%;border:1px solid var(--line);background:#171716;color:#eee;border-radius:14px;padding:.5rem .6rem;font-size:.78rem;line-height:1.2;cursor:pointer}.slot-action:hover{filter:brightness(1.18)}.pack-card{border:1.5px solid #31594f;background:#181a18;border-radius:18px;padding:1rem 1rem 1.4rem;margin:1.2rem 0 2rem}.pack-card .toolbar{margin:.2rem 0 1rem}.pack-card .grid{margin-bottom:0}.pack-card .tabs{margin-top:0}.id-row{display:flex;gap:.45rem}.id-row input{flex:1}.id-row button{border:1px solid var(--line);background:#292927;color:#ddd;border-radius:12px;width:44px;font-size:1.25rem;cursor:pointer}.id-row button:hover{background:#31594f}.settings{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.settings label{display:block;color:#aaa}.settings input{display:block;width:100%;margin-top:.35rem}.export{width:100%;margin-top:1.5rem;font-size:1rem}.warning{color:#e99a9a;font-size:.85rem;margin-top:.6rem}@media(max-width:650px){.grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem}.settings{grid-template-columns:1fr}}
</style></head><body><main>
<div class="top"><a class="back-home" href="/">← 返回主页</a><span class="device">10 Pro</span></div>
<h1>图标投递表盘</h1><div class="muted">▦　图标槽位</div>
<section class="pack-card"><div class="toolbar"><span class="count">已选 <b id="count">0</b> / 55</span><label class="button">批量导入 <input id="files" type="file" accept="image/*" multiple hidden/></label><button class="button" id="clear">⌫</button></div>
<div class="tabs"><button class="tab active" data-group="DESKTOP">桌面</button><button class="tab" data-group="CONTROL">控制中心</button><button class="tab" data-group="SETTINGS">设置</button></div>
<p class="muted">112 × 112 · 日程与日历分别选择，日历使用静态图</p><div id="grid" class="grid"></div></section>
<section><h3>⚙　表盘参数</h3><div class="settings"><label>包名<input id="short" value="MyIcons" maxlength="12"/><small>7/12</small></label><label>表盘名称<input id="packname" value="图标:MyIcons"/></label><label>Lua页面标题<input id="title" value="图标投递 MyIcons" maxlength="16"/></label><label>表盘 ID（12 位数字）<div class="id-row"><input id="pkg" placeholder="留空则按内容推导" maxlength="12"/><button id="random-id" type="button" title="随机生成表盘 ID">↻</button></div></label></div></section>
<section><h3>▣　将写入的包</h3><p class="muted">选择图标后这里会显示包号与体积。</p><button id="export" class="button export primary" disabled>▣　导出 .bin</button><div id="status" class="warning"></div></section>
</main>
<script src="../scripts_icons.ts"></script></body></html>
