<!doctype html>
<html lang="zh-CN"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>图标投递 · Chaos 制作台</title>
<style is:global>
:root{color-scheme:dark;--bg:#101010;--panel:#1d1d1b;--line:#555550;--blue:#a8d7ff}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:#f2f1ed;font-family:system-ui,-apple-system,"PingFang SC",sans-serif}main{width:min(1080px,100%);margin:auto;padding:1.25rem clamp(1rem,4vw,3rem) 3rem}.build-link{display:block;width:max-content;margin:0 auto .45rem;padding:.45rem .85rem;border:1px solid #78bdf2;border-radius:12px;background:#1b1b1b;color:#a8d7ff;font-size:.75rem;text-decoration:none;line-height:1.2}.build-link:hover{background:#78bdf2;color:#14212b}[hidden]{display:none!important}.build-link:hover{color:#a8d7ff}.top{display:flex;justify-content:space-between;align-items:center;color:#aaa;font-size:.8rem}.back-home{color:#a8d7ff;text-decoration:none;padding:.55rem .8rem;border:1px solid #3c3c39;border-radius:12px;transition:background .2s}.back-home:hover{background:#31594f;color:#fff}.github{display:inline-block;color:#a8d7ff;text-decoration:none;background:#1b1b1b;border:1px solid #78bdf2;border-radius:12px;padding:.55rem 1rem;font-weight:600;transition:background .2s,color .2s}.github svg{width:1.05em;height:1.05em;fill:currentColor;vertical-align:-.16em;margin-right:.45rem}.github:hover{background:#78bdf2;color:#14212b}.device{background:var(--blue);color:#17242e;border-radius:18px;padding:.65rem 1rem;font-weight:600}h1{font-size:clamp(1.8rem,4vw,2.7rem);margin:3rem 0 .4rem}.muted{color:#aaa}.toolbar{display:flex;gap:.7rem;align-items:center;flex-wrap:wrap;margin:1.5rem 0}.count{font-size:1.3rem;font-weight:600}.button,input{border:1px solid var(--line);background:#171716;color:#eee;border-radius:14px;padding:.7rem 1rem}.button{cursor:pointer}.button.primary{background:var(--blue);color:#17242e;border:0}.tabs{display:flex;gap:.5rem;margin:1rem 0}.tab{border:1px solid #3c3c39;background:#191918;color:#bbb;border-radius:12px;padding:.55rem 1rem;cursor:pointer}.tab.active{background:#31594f;color:#fff;border-color:#31594f}.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1rem;margin:1rem 0 2rem}.slot{border:1px solid #292927;background:#1d1d1b;border-radius:18px;padding:.8rem;text-align:center}.slot.selected{outline:2px solid var(--blue);background:#26353a}.slot img{width:100%;aspect-ratio:1;border-radius:14px;object-fit:contain;background:#20201f;cursor:pointer}.slot-row{display:flex;flex-direction:column;align-items:stretch;gap:.45rem;margin-top:.65rem}.slot small{display:block;color:#e5e3de;font-size:.82rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.slot-actions{display:flex;flex-direction:column;gap:.5rem;width:100%}.slot-action{width:100%;border:1px solid var(--line);background:#171716;color:#eee;border-radius:14px;padding:.5rem .6rem;font-size:.78rem;line-height:1.2;cursor:pointer}.slot-action:hover{filter:brightness(1.18)}.pack-card{border:1.5px solid #31594f;background:#181a18;border-radius:18px;padding:1rem 1rem 1.4rem;margin:1.2rem 0 2rem}.pack-card .toolbar{margin:.2rem 0 1rem}.pack-card .grid{margin-bottom:0}.pack-card .tabs{margin-top:0}.id-row{display:flex;gap:.45rem}.id-row input{flex:1}.id-row button{border:1px solid var(--line);background:#292927;color:#ddd;border-radius:12px;width:44px;font-size:1.25rem;cursor:pointer}.id-row button:hover{background:#31594f}.settings{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.settings label{display:block;color:#aaa}.settings input{display:block;width:100%;margin-top:.35rem}.export{width:100%;margin-top:1.5rem;font-size:1rem}.warning{color:#e99a9a;font-size:.85rem;margin-top:.6rem}@media(max-width:650px){.grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:.55rem}.settings{grid-template-columns:1fr}}
</style></head><body><main><a id="build-info" class="build-link" hidden target="_blank" rel="noreferrer"></a>
<div class="top"><a class="back-home" href="/">← 返回主页</a><a class="github" href="https://github.com/An2em6o/chaos-bandpack-web" target="_blank" rel="noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.3 11.3 0 0 0-3.57 22.02c.57.1.78-.25.78-.55v-2.16c-3.18.69-3.85-1.34-3.85-1.34-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.68 1.25 3.33.96.1-.74.4-1.25.73-1.54-2.54-.29-5.2-1.27-5.2-5.66 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.45.11-3.03 0 0 .96-.31 3.12 1.17a10.8 10.8 0 0 1 5.68 0c2.16-1.48 3.12-1.17 3.12-1.17.62 1.58.23 2.74.11 3.03.73.8 1.18 1.82 1.18 3.07 0 4.4-2.67 5.36-5.21 5.64.41.36.78 1.08.78 2.18v3.23c0 .3.2.66.79.55A11.3 11.3 0 0 0 12 .7Z"/></svg>GitHub</a></div>
<h1>图标投递表盘</h1><div class="muted">▦　图标槽位</div>
<section class="pack-card"><div class="toolbar"><span class="count">已选 <b id="count">0</b> / 55</span><label class="button">批量导入 <input id="files" type="file" accept="image/*" multiple hidden/></label><button class="button" id="clear">⌫</button></div>
<div class="tabs"><button class="tab active" data-group="DESKTOP">桌面</button><button class="tab" data-group="CONTROL">控制中心</button><button class="tab" data-group="SETTINGS">设置</button></div>
<p class="muted">112 × 112 · 日程与日历分别选择，日历使用静态图</p><div id="grid" class="grid"></div></section>
<section><h3>⚙　表盘参数</h3><div class="settings"><label>包名<input id="short" value="MyIcons" maxlength="12"/><small>7/12</small></label><label>表盘名称<input id="packname" value="图标:MyIcons"/></label><label>Lua页面标题<input id="title" value="图标投递 MyIcons" maxlength="16"/></label><label>表盘 ID（12 位数字）<div class="id-row"><input id="pkg" placeholder="留空则按内容推导" maxlength="12"/><button id="random-id" type="button" title="随机生成表盘 ID">↻</button></div></label></div></section>
<section><h3>▣　将写入的包</h3><p class="muted">选择图标后这里会显示包号与体积。</p><button id="export" class="button export primary" disabled>▣　导出 .bin</button><div id="status" class="warning"></div></section>
</main>
<script src="../scripts_icons.ts"></script><script>fetch(new URL("../build.txt", document.baseURI)).then(r => r.ok ? r.text() : Promise.reject()).then(v => { const c=v.trim(); if (!/^[0-9a-f]{7,40}$/i.test(c)) throw 0; const e=document.querySelector("#build-info"); if(e){e.textContent=`build@${c.slice(0,8)}`;e.href=`https://github.com/An2em6o/chaos-bandpack-web/commit/${c}`;e.hidden=false;} }).catch(() => {});</script></body></html>
