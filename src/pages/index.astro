---
const cards = [
  { href: "/font", title: "字体投递", subtitle: "归一化 · 精简字集", kind: "font", icon: "永", mark: "A" },
  { href: "/icons", title: "图标投递", subtitle: "55 槽 · 桌面与系统图标", kind: "icons", images: ["/home-icons/icon-1.png", "/home-icons/icon-2.png", "/home-icons/icon-3.png", "/home-icons/icon-4.png"] },
];
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Chaos 制作台</title>
    <style>
      :root { color-scheme:dark; --bg:#101010; --panel:#1d1d1b; --blue:#a8d7ff; }
      * { box-sizing:border-box; } body { margin:0; min-height:100vh; background:var(--bg); color:#f3f2ee; font-family:system-ui,-apple-system,"PingFang SC",sans-serif; }
      main { width:min(1080px,100%); margin:auto; padding:clamp(1.25rem,5vw,4rem); }
      header { display:flex; justify-content:space-between; align-items:center; margin-bottom:clamp(2rem,8vw,6rem); opacity:.8; }
      .version { font-size:.85rem; letter-spacing:.12em; } .device { padding:.7rem 1rem; border-radius:1.2rem; background:var(--blue); color:#14212b; font-weight:600; }
      .intro { margin-bottom:2rem; } .intro h1 { margin:0; } .intro p { color:#bcbab4; margin:.25rem 0 0; font-size:1.1rem; }
      .cards { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.5rem; }
      .card { min-height:360px; padding:1.8rem; color:inherit; text-decoration:none; background:var(--panel); border:1px solid #292927; border-radius:2rem; transition:transform .2s,background .2s; }
      .card:hover { transform:translateY(-4px); background:#252523; }
      .art { width:100%; min-height:270px; aspect-ratio:1.65; border-radius:1.6rem; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:1.25rem; place-items:center; align-content:center; padding:2.25rem 3rem; background:#24332e; }
      .icons .art { background:#3a2d25; } .image-bubble { overflow:hidden; padding:0; } .image-bubble img { width:100%; height:100%; object-fit:cover; } .bubble { width:82px; height:82px; display:grid; place-items:center; border-radius:2rem; background:#34413c; font-size:3rem; } .icons .bubble { font-size:2.5rem; background:#57453a; }
      h1 { font-size:clamp(2rem,5vw,3rem); margin:1.5rem 0 .25rem; } .subtitle { color:#bcbab4; font-size:1.15rem; }
      .steps { display:flex; justify-content:space-around; margin-top:clamp(3rem,10vw,8rem); color:#bcbab4; text-align:center; } .step-dot { width:76px;height:76px;border-radius:50%;display:grid;place-items:center;margin:auto;background:#222; font-size:2rem; }.step:first-child .step-dot{background:var(--blue);color:#14212b} .step-line{height:3px;flex:0 1 120px;background:#3a3937;margin:38px 1rem 0}
      @media(max-width:650px){ .cards{grid-template-columns:1fr}.card{min-height:300px}.art{min-height:230px;aspect-ratio:1.55;padding:1.5rem 2rem;gap:.8rem}.bubble{width:64px;height:64px;font-size:2.3rem}.steps{gap:.4rem}.step-line{margin-left:.2rem;margin-right:.2rem}.step-dot{width:60px;height:60px}}
    </style>
  </head>
  <body><main>
    <header><span class="version">10 Pro · 3.101.043</span><span class="device">10 Pro</span></header>
    <section class="intro"><h1>Chaos传递包制作网页</h1><p>By @IKUN_CXKPRO ，使用Astro框架制作</p></section>
    <section class="cards">
      {cards.map((card) => <a class={`card ${card.kind}`} href={card.href}><div class="art">{card.images ? card.images.map((src) => <span class="bubble image-bubble"><img src={src} alt="图标预览" /></span>) : <><span class="bubble">永</span><span class="bubble">A</span><span class="bubble">字</span><span class="bubble">01</span></>}</div><h1>{card.title}</h1><div class="subtitle">{card.subtitle}</div></a>)}
    </section>
    <section class="steps"><div class="step"><div class="step-dot">⇩</div><div>备素材</div></div><div class="step-line"></div><div class="step"><div class="step-dot">☷</div><div>出包</div></div><div class="step-line"></div><div class="step"><div class="step-dot">➤</div><div>投递</div></div></section>
  </main></body>
</html>
